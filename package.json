{
  "name": "agenda-estetica",
  "version": "1.0.0",
  "description": "Agendamento e prontuário para clínica de estética",
  "main": "api/index.ts",
  "scripts": {
    "build:client": "tsx scripts/build-client.ts",
    "build": "npm run typecheck && tsx scripts/build-client.ts --minify",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "dev": "npm run build:client && node --env-file-if-exists=.env --import tsx src/server/dev.ts",
    "start": "npm run dev",
    "test": "tsx test/api.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": "22.x"
  }
}
